{
  "expo": {
    "name": "TradeMind AI",
    "slug": "trademind-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B0F17",
    "splash": {
      "backgroundColor": "#0B0F17",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.trademind.ai"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B0F17"
      },
      "package": "com.trademind.ai",
      "versionCode": 1,
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "SCHEDULE_EXACT_ALARM",
        "INTERNET",
        "ACCESS_NETWORK_STATE"
      ]
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#38BDF8"
        }
      ]
    ]
  }
}
