# =====================================================================
# TradeMind AI - Client Environment Configuration Template
# All client-accessible variables MUST start with EXPO_PUBLIC_
# NEVER put private secret keys (OpenAI, TwelveData) in this file!
# =====================================================================

# Secure Backend Microservice URL (Proxies OpenAI and Forex requests)
EXPO_PUBLIC_BACKEND_URL=http://localhost:3001

# Supabase Authentication & PostgreSQL Database (Public Anon Key ONLY)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Institutional Risk Management Defaults
EXPO_PUBLIC_DEFAULT_RISK_PER_TRADE_PCT=0.5
EXPO_PUBLIC_MAX_DAILY_LOSS_PCT=1.5
EXPO_PUBLIC_MAX_SIMULTANEOUS_POSITIONS=2
EXPO_PUBLIC_MIN_RISK_REWARD_RATIO=2.0
